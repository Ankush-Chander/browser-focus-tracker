{
  "manifest_version": 3,
  "name": "FocusTracker",
  "version": "1.0",
  "description": "Track focus and tab switching behavior",

  "permissions": [
    "tabs",
    "storage",
    "downloads"
  ],
  
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}